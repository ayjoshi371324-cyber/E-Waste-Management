{
  "info": {
    "name": "Smart E-Waste Recycling Platform API",
    "description": "Complete Postman collection for Smart E-Waste Recycling & Sustainability Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen.jane@example.com\",\n  \"password\": \"AdminPass123!\",\n  \"full_name\": \"Jane Citizen\",\n  \"role_id\": 2,\n  \"phone\": \"+1-555-0200\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen.jane@example.com\",\n  \"password\": \"AdminPass123!\"\n}"
        }
      }
    },
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Catalog - List Categories",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Centers - Nearby Spatial Search",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/centers/nearby?lat=12.9716&lng=77.5946&radius_km=25&verified_only=true"
      }
    },
    {
      "name": "AI - Classify Device Photo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/ai/classify-device",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" }
          ]
        }
      }
    },
    {
      "name": "Records - Submit Evidence",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/records",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"center_id\": \"33333333-3333-3333-3333-333333330001\",\n  \"category_id\": \"11111111-1111-1111-1111-111111110002\",\n  \"weight_kg\": 2.5,\n  \"estimated_units\": 1,\n  \"receipt_number\": \"REC-DEMO-001\",\n  \"notes\": \"Working laptop for recycling\"\n}"
        }
      }
    },
    {
      "name": "Admin - Review Queue",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/records/queue"
      }
    },
    {
      "name": "Rewards - List Catalog",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/rewards"
      }
    },
    {
      "name": "Rewards - My Balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/rewards/my-balance"
      }
    },
    {
      "name": "Analytics - Community Dashboard",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/analytics/community"
      }
    }
  ]
}
