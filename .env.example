# Database & Service Operating Modes
# DB_MODE: 'mock' (in-memory test mode, default) or 'postgres' (live PostgreSQL+PostGIS)
DB_MODE=mock
# MONGO_MODE: 'mock' (in-memory test mode, default) or 'mongo' (live MongoDB)
MONGO_MODE=mongo
# AI_MODE: 'stub' (fast deterministic stub, default) or 'model' (PyTorch MobileNetV3)
AI_MODE=stub
AI_MODEL_PATH=

# Application Environment
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_secure_random_hex_string_32_bytes
SESSION_COOKIE_NAME=ewaste_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS (Used when DB_MODE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ewaste_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ewaste_db
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# MongoDB (Used when MONGO_MODE=mongo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ewaste_meta

# Upload & File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# PyTorch AI Model (Used when AI_MODE=model)
AI_MODEL_NAME=mobilenet_v3_small
AI_CONFIDENCE_THRESHOLD=0.60
AI_DEVICE=cpu


